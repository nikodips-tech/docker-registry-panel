# Registry the backend talks to (required)
REGISTRY_URL=http://localhost:5500
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# Shown in the top bar (default: hostname of REGISTRY_URL)
REGISTRY_TITLE=
# Prefix for the docker pull command (default: hostname of REGISTRY_URL)
PULL_URL=
# Enable the delete buttons (requires REGISTRY_STORAGE_DELETE_ENABLED=true on the registry)
DELETE_IMAGES=true
SHOW_TAG_COUNT=false
CATALOG_MIN_BRANCHES=1
CATALOG_MAX_BRANCHES=1
CACHE_TTL_SECONDS=60
THEME=auto
PORT=3000
